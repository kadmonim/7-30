---
// Changelog: every halachic change to the calculator, what exactly was modified,
// and how far it has been verified against each custom. Newest entry first.
import HamburgerMenu from '../components/HamburgerMenu.astro';
import ReviewBanner from '../components/ReviewBanner.astro';
---

<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>יומן שינויים — יתגדל</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;700&family=Frank+Ruhl+Libre:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>

<div class="container">
  <span class="bsd">בס״ד</span>
  <HamburgerMenu currentPage="/changelog" />
  <ReviewBanner />

  <h1>יומן שינויים</h1>
  <p class="subtitle">כל שינוי הלכתי במחשבון: מה בדיוק השתנה, מה המקור, ועד כמה הוא נבדק לפי כל מנהג</p>

  <section class="log-entry">
    <div class="log-head">
      <h2>תפילה בשבעה — פרק מ״ט, פרק ט״ז, ואזכרה</h2>
      <div class="log-meta">
        <span class="log-date">ז׳ כסלו תשפ״ז · 17 בנובמבר 2026</span>
        <span class="status status-pending">ממתין לאישור רב</span>
      </div>
    </div>

    <div class="rule-card">
      <h3>מה השתנה</h3>
      <ul>
        <li><strong>פרק מ״ט</strong> מוצג רק בימים שאומרים אותו. אין אומרים בראש חודש, חנוכה, פורים, ניסן, תשרי אחרי יום כיפור, ובמנחה של ערב שבת.</li>
        <li><strong>חב״ד:</strong> שחרית ומנחה, לא ערבית; באותם ימים — ״היום אין אומרים פרק מ״ט״.</li>
        <li><strong>אשכנז:</strong> אחרי שחרית; אחרי מנחה לפי קיצור שו״ע, ויש נוהגים בערבית. באותם ימים — פרק ט״ז (״מכתם לדוד״) במקומו.</li>
        <li><strong>ספרדים:</strong> הערה שהבאר הגולה מביא לאומרו סמוך לערבית — ממקור משני, לבדיקה.</li>
        <li><strong>כרטיס חדש ״אזכרה והשכבה״</strong> בתחתית הדף, לפי מנהג: ספרדים — ליל השבעה, ליל השלושים, י״א וי״ב חודש, השכבה; חב״ד — אין ״א-ל מלא רחמים״, סיום ביום השלושים, ״תיקון״ ביארצייט; אשכנז — ״א-ל מלא רחמים״ ביארצייט.</li>
      </ul>
    </div>

    <div class="rule-card">
      <h3>מקורות ובדיקה</h3>
      <ul>
        <li>חב״ד: המדריך ח״ד פ״ט ס״ד:כד–כז. הימים שאין אומרים — אתר ״שולחן ערוך הרב״, ״אמירת קאפיטל מ״ט בבית האבל״ (דעת קדושים; מנהג הרבי בתשמ״ח).</li>
        <li>אשכנז: קיצור שו״ע ר״ז:ה; גשר החיים, נטעי גבריאל ופני ברוך — כפי שהובאו באתר הנ״ל; OU Torah ו-Chabad.org.</li>
        <li>ספרדים: קיצור ילקוט יוסף סי׳ כא, לב, לו, מ, מב; JIMENA.</li>
        <li class="partial">מה שמסומן בדף ״מקור משני״ לא נבדק בספר עצמו.</li>
      </ul>
    </div>
  </section>

  <section class="log-entry">
    <div class="log-head">
      <h2>דפים חדשים — תפילה בשבעה, וקדיש</h2>
      <div class="log-meta">
        <span class="log-date">ז׳ כסלו תשפ״ז · 17 בנובמבר 2026</span>
        <span class="status status-pending">ממתין לאישור רב</span>
      </div>
    </div>

    <div class="rule-card">
      <h3>מה נוסף</h3>
      <ul>
        <li><strong>״תפילה בשבעה״</strong> (<a href="/tefila">/tefila</a>) למי שעובר לפני התיבה בבית האבל: בוחרים מנהג ויום (ברירת המחדל — היום), ומוצג מה מוסיפים ומה מדלגים בשחרית, במנחה ובערבית של אותו יום בלבד — לפי סוג היום: ראש חודש, חנוכה, שני וחמישי, תענית, ערב שבת ומוצאי שבת. ערבית נחשבת ליום העברי הבא. בשבת עצמה הדף אינו מציג את תפילות היום. כל שורה עם מקורה.</li>
        <li><strong>״קדיש״</strong> (<a href="/kaddish">/kaddish</a>): קדיש יתום וקדיש דרבנן לכל אחד משלושת הנוסחים, עם כפתורי הגדלה והקטנה של הגופן. הבחירות נשמרות בדפדפן.</li>
        <li>מנהגי השנה והיארצייט נאספו מהמקורות, אבל עדיין אינם מוצגים — הדף עוסק בשבעה בלבד.</li>
        <li><strong>מה לא השתנה:</strong> המחשבון.</li>
      </ul>
    </div>

    <div class="rule-card">
      <h3>מקורות ובדיקה</h3>
      <div class="table-wrap">
        <table class="log-table">
          <thead>
            <tr><th>מנהג</th><th>מנהגי התפילה</th><th>נוסח הקדיש</th><th>נבדק?</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>חב״ד</td>
              <td>המדריך ח״ד פ״ט; ח״ו פ״ד; ח״ז פ״ג–ד, פ״ז; ח״ב פ״ו</td>
              <td>סידור תורה אור, דפוס תש״א (העתק בוויקיטקסט)</td>
              <td class="ok">הועתק מהמקורות</td>
            </tr>
            <tr>
              <td>ספרדים</td>
              <td>קיצור ילקוט יוסף סי׳ כה, כט, ל, לא, לב</td>
              <td>סידור עדות המזרח (ספריא)</td>
              <td class="ok">הועתק מהמקורות</td>
            </tr>
            <tr>
              <td>אשכנז</td>
              <td>שו״ע או״ח קל״א:ד; רמ״א יו״ד שע״ו:ד, שפ״ד:ג, ת״ב:יב; משנ״ב קל״א:כ; קיצור שו״ע כ״ו, ר״ז</td>
              <td>הסידור השלם (בירנבוים) (העתק בוויקיטקסט)</td>
              <td class="partial">חלקי</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rule-card open-card">
      <h3>מה עדיין פתוח</h3>
      <ul>
        <li>ראו ב<a href="/questions">שאלות פתוחות</a>, תחת ״סדר התפילה וקדיש״: נוסח הקדיש בחב״ד מול ״תהלת ה׳״, בדיקת מנהגי אשכנז, פרק מ״ט לספרדים, והלל ביארצייט לחב״ד.</li>
        <li>נוסח ההשכבה עצמה, ו״א-ל מלא רחמים״ למי שנוהג לאומרו — עדיין לא נוספו.</li>
      </ul>
    </div>
  </section>

  <section class="log-entry">
    <div class="log-head">
      <h2>יארצייט בחודש ניסן — הודעה על עלייה לקבר</h2>
      <div class="log-meta">
        <span class="log-date">ז׳ כסלו תשפ״ז · 17 בנובמבר 2026</span>
        <span class="status status-verified">תוספת למחשבון</span>
      </div>
    </div>

    <div class="rule-card">
      <h3>מה השתנה</h3>
      <ul>
        <li><strong>עכשיו:</strong> כשהיארצייט חל בחודש ניסן, מופיעה בתוצאות המחשבון, מתחת לתאריכי היארצייט, הודעה על המנהגים בעלייה לקבר בניסן, עם קישור לדף ״מתי עולים״.</li>
        <li><strong>קודם:</strong> המידע הופיע רק בדף ״מתי עולים״.</li>
        <li><strong>מה לא השתנה:</strong> התאריכים, והנוסח שבדף ״מתי עולים״.</li>
      </ul>
    </div>

    <div class="rule-card">
      <h3>למה</h3>
      <ul>
        <li>הערת רב: מי שנוהג שלא לעלות לקבר בניסן צריך לדעת מראש שעליו לעלות בערב ראש חודש, ולא לגלות זאת ביום היארצייט.</li>
      </ul>
    </div>

    <div class="rule-card">
      <h3>בדיקה לפי מנהגים</h3>
      <div class="table-wrap">
        <table class="log-table">
          <thead>
            <tr><th>מנהג</th><th>הדין</th><th>מקור</th><th>נבדק?</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>הנמנעים</td>
              <td>אין עולים כל חודש ניסן; עולים בערב ראש חודש ניסן.</td>
              <td>נטעי גבריאל פסח ג:ח, אבלות עו:יז</td>
              <td class="partial">הועתק מדף ״מתי עולים״; לא נבדק בספר</td>
            </tr>
            <tr>
              <td>ספרדים</td>
              <td>״אם חל יום השנה בחודש ניסן, מותר לילך לבית הקברות, אם נזהרים שלא להספיד את המת, ושלא לבוא לידי בכי״</td>
              <td>קיצור ילקוט יוסף סי׳ מ:כז</td>
              <td class="ok">נבדק בלשון הספר</td>
            </tr>
            <tr>
              <td>חב״ד</td>
              <td>״אם מוכרחים ללכת בחודש ניסן, מותר אם אין אומרים השכבות והספדים״</td>
              <td>המדריך ח״ח פ״ב ס״א</td>
              <td class="ok">נבדק בלשון הספר</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rule-card open-card">
      <h3>מה עדיין פתוח</h3>
      <ul>
        <li>ההודעה מופיעה ליארצייט בלבד. עלייה לקבר ביום השבעה או ביום השלושים שחלים בניסן, ושאר הימים שאין עולים בהם (ראש חודש, חנוכה, פורים, חול המועד) — מופיעים עדיין רק בדף ״מתי עולים״.</li>
      </ul>
    </div>
  </section>

  <section class="log-entry">
    <div class="log-head">
      <h2>פטירה בבין השמשות — תאריך נוסף גם ליארצייט הראשון</h2>
      <div class="log-meta">
        <span class="log-date">ז׳ כסלו תשפ״ז · 17 בנובמבר 2026</span>
        <span class="status status-verified">תיקון במחשבון</span>
      </div>
    </div>

    <div class="rule-card">
      <h3>מה השתנה</h3>
      <ul>
        <li><strong>קודם:</strong> כשסומן ״הפטירה היתה בבין השמשות״, המחשבון הציג תאריך נוסף (היום המאוחר) ליארצייט השני ואילך בלבד.</li>
        <li><strong>עכשיו:</strong> התאריך הנוסף מוצג גם ליארצייט הראשון, שהרי הספק אחד הוא.</li>
        <li><strong>יוצא מן הכלל:</strong> כשהיום המאוחר הוא תאריך שכבר מוצג ליארצייט הראשון (למשל כשהקבורה היתה למחרת, והוא התאריך ״לפי תאריך הקבורה״), לא נוספת שורה כפולה.</li>
        <li><strong>מה לא השתנה:</strong> שאר התאריכים.</li>
      </ul>
    </div>

    <div class="rule-card">
      <h3>מקור ובדיקה</h3>
      <ul>
        <li>הערת רב.</li>
        <li>״אם אין ידוע אם יום הפטירה הי׳ ביום א׳ או למחרתו, או שנפטר בין השמשות… יתפלל ויאמר קדיש בב׳ הימים. אם יש אבלים אחרים… יחזיק את היארצייט ביום המוקדם״ <span class="source">(המדריך ח״ז פ״א ס״ד)</span>. הספר אינו מחלק בין שנה ראשונה לשאר השנים. נבדק בלשון הספר.</li>
      </ul>
    </div>
  </section>

  <section class="log-entry">
    <div class="log-head">
      <h2>ערב פסח — תיקון המקורות והפרדה לפי מנהגים</h2>
      <div class="log-meta">
        <span class="log-date">ז׳ כסלו תשפ״ז · 17 בנובמבר 2026</span>
        <span class="status status-pending">ממתין לאישור רב</span>
      </div>
    </div>

    <div class="rule-card">
      <h3>מה השתנה</h3>
      <ul>
        <li><strong>קודם:</strong> המחשבון ודף הכללים כתבו לכל אבל ״השבעה/השלושים מסתיימים בחצות היום של ערב פסח״, וציינו ״מחבר או״ח תקמ״ח:יב, יו״ד שצ״ט:ז״.</li>
        <li><strong>הציון היה שגוי.</strong> שני הסעיפים האלה עוסקים במנין ט״ו הימים של פסח לשלושים, ואין בהם דין חצות.</li>
        <li><strong>עכשיו, שבעה:</strong> מנהג חב״ד — האבלות נפסקת בחצות היום. מנהג הספרדים — סמוך לכניסת החג.</li>
        <li><strong>עכשיו, שלושים:</strong> מנהג אשכנז וחב״ד — מותר בכל אחר חצות, ומסתפרים קודם חצות. מנהג הספרדים — מותר בערב החג.</li>
        <li><strong>קבורה לפני ערב פסח:</strong> ההערה ״קבורה לפני חצות… קבורה אחרי חצות…״ הופיעה גם כשהקבורה היתה בי״ג ניסן או קודם, אף שאז היא בוודאי לפני חצות. עכשיו ההבחנה מופיעה רק כשהקבורה היתה בערב פסח עצמו (הערת רב).</li>
        <li><strong>מה לא השתנה:</strong> התאריכים. ערב פסח נשאר היום האחרון בשני המקרים; השינוי הוא בשעה שביום, ובמקורות.</li>
      </ul>
    </div>

    <div class="rule-card">
      <h3>בדיקה לפי מנהגים</h3>
      <div class="table-wrap">
        <table class="log-table">
          <thead>
            <tr><th>מנהג</th><th>הדין</th><th>מקור</th><th>נבדק?</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>חב״ד — שבעה</td>
              <td>״אין אבלות נוהגת אחר חצות מזמן שחיטת הפסח ולמעלה״</td>
              <td>המדריך ח״ד פי״ד ס״ה (דרכי חסד ריז)</td>
              <td class="ok">נבדק בלשון הספר</td>
            </tr>
            <tr>
              <td>אשכנז וחב״ד — שלושים</td>
              <td>״ובערב פסח מותר בכל אחר חצות… ועדיף שיגלח קודם חצות״</td>
              <td>רמ״א יו״ד שצ״ט:ג; המדריך ח״ה פ״ט ס״ד</td>
              <td class="ok">נבדק בלשון המקורות</td>
            </tr>
            <tr>
              <td>ספרדים — שבעה</td>
              <td>״אף שהרגל מבטל ממנו גזרת שבעה, כל זה הוא דוקא משיגיע סמוך לחשכה ממש״. זהו דין כללי לכל ערב חג; דין מיוחד לערב פסח לא נמצא בספר.</td>
              <td>קיצור ילקוט יוסף סי׳ מב:ב</td>
              <td class="partial">נבדק; הדין הכללי בלבד</td>
            </tr>
            <tr>
              <td>ספרדים — שלושים</td>
              <td>״ומותר לכבס ולהתרחץ ולהסתפר בערב הרגל״, בלי הגבלת שעה</td>
              <td>שו״ע יו״ד שצ״ט:ג; קיצור ילקוט יוסף סי׳ מב:כו</td>
              <td class="ok">נבדק בלשון המקורות</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rule-card open-card">
      <h3>מה עדיין פתוח</h3>
      <ul>
        <li><strong>קבורה לפני חצות או אחריו.</strong> המחשבון מבחין: קבורה לפני חצות — השבעה מסתיימת בחצות; אחרי חצות — בכניסת החג. ההבחנה הזאת אינה כתובה ב״המדריך״; היא נשארה מהנוסח הקודם.</li>
        <li><strong>אשכנז — שבעה.</strong> יש פוסקים שהאבלות נמשכת עד הלילה גם בערב פסח, ושדברי הרמ״א נאמרו על השלושים בלבד. לא נבדק במקור.</li>
        <li><strong>ספרדים בערב פסח.</strong> כתבנו את הדין הכללי של ערב חג. צריך לברר אם יש לספרדים דין מיוחד לערב פסח.</li>
      </ul>
    </div>
  </section>

  <section class="log-entry">
    <div class="log-head">
      <h2>דף הכללים — יום שישי שבתוך השבעה</h2>
      <div class="log-meta">
        <span class="log-date">ז׳ כסלו תשפ״ז · 17 בנובמבר 2026</span>
        <span class="status status-verified">תיקון לפי המקור</span>
      </div>
    </div>

    <div class="rule-card">
      <h3>מה השתנה</h3>
