---
// Prayer customs in the shiva house for one chosen day (default: today), by custom, split into
// Shacharit, Mincha and Maariv. Rules live in src/data/tefila.ts; the kind of day comes from
// src/lib/dayinfo.ts. Everything is worked out in the browser for the chosen date.
import HamburgerMenu from '../components/HamburgerMenu.astro';
import ReviewBanner from '../components/ReviewBanner.astro';
import { nusachLabels, nusachSources } from '../data/tefila';
import type { Nusach } from '../data/kaddish';

const nusachim: Nusach[] = ['chabad', 'sefardi', 'ashkenaz'];
---

<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>תפילה בבית האבל — יתגדל</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;700&family=Frank+Ruhl+Libre:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>

<div class="container">
  <span class="bsd">בס״ד</span>
  <HamburgerMenu currentPage="/tefila" />
  <ReviewBanner />

  <h1>תפילה בבית האבל</h1>
  <p class="subtitle">למי שעובר לפני התיבה בימי השבעה: מה מוסיפים ומה מדלגים — ביום שבחרתם</p>

  <div class="controls">
    <div class="nusach-bar" role="tablist" aria-label="מנהג">
      <span class="ctl-label">מנהג:</span>
      {nusachim.map((n) => (
        <button type="button" class="nusach-btn" data-set-nusach={n} role="tab">{nusachLabels[n]}</button>
      ))}
    </div>
    <div class="date-bar">
      <span class="ctl-label">יום:</span>
      <button type="button" class="day-step" id="prev-day" aria-label="היום הקודם">‹</button>
      <input type="date" id="day" />
      <button type="button" class="day-step" id="next-day" aria-label="היום הבא">›</button>
      <button type="button" class="today-btn" id="today-btn">היום</button>
    </div>
  </div>

  <p class="day-title" id="day-title"></p>
  <div class="chips" id="chips"></div>
  <p class="nusach-source" id="nusach-source"></p>

  <section class="prayer" id="card-G"><h2>כל היום</h2><ul class="items"></ul></section>
  <section class="prayer" id="card-S"><h2>שחרית</h2><p class="when"></p><ul class="items"></ul></section>
  <section class="prayer" id="card-M"><h2>מנחה</h2><p class="when"></p><ul class="items"></ul></section>
  <section class="prayer" id="card-A"><h2>ערבית</h2><p class="when"></p><ul class="items"></ul></section>

  <p class="kaddish-link"><a href="/kaddish">נוסח הקדיש ←</a></p>

  <div class="sources">
    <h3>על הדף</h3>
    <p>מוצגים רק השינויים בימי השבעה, ולא כל נוסח התפילה. כל שורה מציינת את מקורה; מנהגי חב״ד לפי ״המדריך״ ומנהגי הספרדים לפי קיצור ילקוט יוסף. ערבית שייכת ליום העברי הבא (ערבית של ערב ראש חודש — היא כבר של ראש חודש). השאלות הפתוחות — ב<a href="/questions">שאלות פתוחות</a>. אין לסמוך על הדף למעשה בלי לשאול רב.</p>
  </div>
</div>

<script>
  import { rules, nusachSources, type Cond, type Prayer } from '../data/tefila';
  import { dayInfo, addDays, type DayInfo } from '../lib/dayinfo';

  type N = 'chabad' | 'sefardi' | 'ashkenaz';
  const kindLabel = { add: 'מוסיפים', skip: 'מדלגים', note: 'שימו לב' } as const;
  const dayNames = ['יום ראשון', 'יום שני', 'יום שלישי', 'יום רביעי', 'יום חמישי', 'יום שישי', 'שבת'];

  const pad = (n: number) => String(n).padStart(2, '0');
  const todayStr = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };

  let nusach: N = 'chabad';
  try { const s = localStorage.getItem('yisgadal-nusach'); if (s === 'chabad' || s === 'sefardi' || s === 'ashkenaz') nusach = s; } catch {}
  const dayInput = document.getElementById('day') as HTMLInputElement;
  dayInput.value = new URLSearchParams(location.search).get('d') || todayStr();

  /** Does a rule's condition hold for this prayer? `day` is the Hebrew day the prayer belongs to. */
  function holds(c: Cond, p: Prayer, day: DayInfo, civil: DayInfo): boolean {
    switch (c) {
      case 'always': return true;
      case 'reading': return p === 'S' && day.reading;
      case 'monThu': return day.monThu;
      case 'rc': return day.rc;
      case 'chanukah': return day.chanukah;
      case 'tachanun': return !day.rc && !day.chanukah;
      case 'fast': return day.fast;
      case 'ayt': return day.ayt;
      case 'fastOrAyt': return day.fast || day.ayt;
      case 'tishaBav': return day.tishaBav;
      case 'friday': return p === 'M' && civil.weekday === 5;
      case 'shabbatNight': return p === 'A' && civil.weekday === 5;
      case 'motzash': return p === 'A' && civil.weekday === 6;
    }
  }

  function chipsFor(d: DayInfo): string[] {
    const c: string[] = [];
    if (d.holiday) c.push('יום טוב / חול המועד');
    if (d.rc) c.push('ראש חודש');
    if (d.chanukah) c.push('חנוכה');
    if (d.tishaBav) c.push('תשעה באב'); else if (d.fast) c.push('תענית ציבור');
    if (d.ayt && !d.holiday) c.push('עשרת ימי תשובה');
    if (d.reading) c.push('קריאת התורה');
    return c;
  }

  function fill(p: Prayer, items: { kind: 'add' | 'skip' | 'note'; text: string; src: string }[], message?: string) {
    const ul = document.querySelector(`#card-${p} .items`)!;
    if (message) { ul.innerHTML = `<li class="msg">${message}</li>`; return; }
    ul.innerHTML = items.length
      ? items.map((it) => `<li class="item"><span class="tag tag-${it.kind}">${kindLabel[it.kind]}</span><span>${it.text} <span class="source">(${it.src})</span></span></li>`).join('')
      : '<li class="msg">אין שינוי מיוחד בתפילה זו.</li>';
  }

  function render() {
    const date = dayInput.value || todayStr();
    const civil = dayInfo(date);
    const night = dayInfo(addDays(date, 1)); // Maariv belongs to the next Hebrew day
    const isShabbat = civil.weekday === 6;

    document.getElementById('day-title')!.textContent = `${dayNames[civil.weekday]}, ${civil.hebrew}`;
    document.getElementById('chips')!.innerHTML = chipsFor(civil).map((c) => `<span class="chip">${c}</span>`).join('');
    document.getElementById('nusach-source')!.textContent = nusachSources[nusach];
    document.querySelectorAll<HTMLButtonElement>('[data-set-nusach]').forEach((b) => {
      const on = b.dataset.setNusach === nusach;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', String(on));
    });

    const pick = (p: Prayer, day: DayInfo) =>
      rules.filter((r) => r.n === nusach && r.sit.includes('shiva') && r.p.includes(p) && holds(r.when, p, day, civil));

    document.querySelector('#card-S .when')!.textContent = civil.hebrew;
    document.querySelector('#card-M .when')!.textContent = civil.weekday === 5 ? `${civil.hebrew} — ערב שבת` : civil.hebrew;
    document.querySelector('#card-A .when')!.textContent =
      civil.weekday === 5 ? `ליל שבת, ${night.hebrew}` : civil.weekday === 6 ? `מוצאי שבת, ליל ${night.hebrew}` : `ליל ${night.hebrew}`;

    const festival = 'יום טוב או חול המועד — דיני השבעה שונים בחג. ראו <a href="/rules">כללים</a> ושאלו רב.';
    fill('G', pick('G', civil));
    if (isShabbat) {
      fill('S', [], 'שבת — הדף אינו מיועד לשבת.');
      fill('M', [], 'שבת — הדף אינו מיועד לשבת.');
    } else {
      fill('S', pick('S', civil), civil.holiday ? festival : undefined);
      fill('M', pick('M', civil), civil.holiday ? festival : undefined);
    }
    if (civil.weekday === 5) {
      // Friday night is Shabbat: show only what is prepared for it, if anything.
      const prep = pick('A', night).filter((r) => r.when === 'shabbatNight');
      fill('A', prep, prep.length ? undefined : 'ליל שבת — הדף אינו מיועד לשבת.');
    } else {
      fill('A', pick('A', night), night.holiday ? festival : undefined);
    }

    const url = new URL(location.href);
    if (date === todayStr()) url.searchParams.delete('d'); else url.searchParams.set('d', date);
    history.replaceState(null, '', url);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-set-nusach]').forEach((b) =>
    b.addEventListener('click', () => {
      nusach = b.dataset.setNusach as N;
      try { localStorage.setItem('yisgadal-nusach', nusach); } catch {}
      render();
    }),
  );
  dayInput.addEventListener('change', render);
  document.getElementById('prev-day')!.addEventListener('click', () => { dayInput.value = addDays(dayInput.value || todayStr(), -1); render(); });
  document.getElementById('next-day')!.addEventListener('click', () => { dayInput.value = addDays(dayInput.value || todayStr(), 1); render(); });
  document.getElementById('today-btn')!.addEventListener('click', () => { dayInput.value = todayStr(); render(); });
  render();
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Heebo', sans-serif; background: #faf9f6; color: #2c2c2c; line-height: 1.7; min-height: 100vh; }
  .container { max-width: 720px; margin: 0 auto; padding: 2rem 2rem 3rem; position: relative; }
  .bsd { display: block; text-align: center; font-family: 'Frank Ruhl Libre', serif; font-size: 0.75rem; color: #c4b89a; user-select: none; margin-bottom: -0.5rem; }
  h1 { font-family: 'Frank Ruhl Libre', serif; font-size: 2rem; font-weight: 700; color: #4a3c2c; text-align: center; margin-top: 2rem; margin-bottom: 0.3rem; }
  .subtitle { text-align: center; color: #888; font-size: 0.95rem; margin-bottom: 1.25rem; }

  .controls { background: #f0ebe1; border: 1px solid #e0d8c8; border-radius: 10px; padding: 0.7rem; display: grid; gap: 0.55rem; }
  .nusach-bar, .date-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.4rem; }
  .ctl-label { font-weight: 700; color: #6d5a43; margin-inline-end: 0.2rem; }
  .nusach-btn, .day-step, .today-btn {
    font: inherit; font-weight: 700; cursor: pointer; padding: 0.3rem 0.9rem;
    border: 1px solid #d4c5a9; border-radius: 8px; background: #fff; color: #6d5a43;
  }
  .day-step { padding: 0.3rem 0.7rem; font-size: 1.1rem; line-height: 1.2; }
  .nusach-btn.active { background: #8b7355; border-color: #8b7355; color: #fff; }
  #day { font: inherit; padding: 0.3rem 0.5rem; border: 1px solid #d4c5a9; border-radius: 8px; background: #fff; color: #2c2c2c; }

  .day-title { text-align: center; font-family: 'Frank Ruhl Libre', serif; font-size: 1.35rem; font-weight: 700; color: #4a3c2c; margin-top: 1.1rem; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem; margin-top: 0.35rem; min-height: 0.5rem; }
  .chip { font-size: 0.78rem; font-weight: 700; color: #7a5600; background: #fbf1d8; border: 1px solid #ecd9a4; border-radius: 999px; padding: 0.05rem 0.65rem; }
  .nusach-source { text-align: center; font-size: 0.8rem; color: #999; margin: 0.4rem 0 1rem; }

  .prayer { background: #fff; border: 1px solid #e0d8c8; border-radius: 10px; padding: 0.85rem 1.1rem; margin-bottom: 0.9rem; }
  .prayer h2 { font-family: 'Frank Ruhl Libre', serif; font-size: 1.3rem; color: #4a3c2c; display: inline-block; }
  .prayer .when { display: inline-block; margin-inline-start: 0.6rem; font-size: 0.85rem; color: #999; }
  .items { list-style: none; margin-top: 0.35rem; }
  .item { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.45rem 0; border-top: 1px solid #f1ebe0; font-size: 0.93rem; }
  .msg { font-size: 0.9rem; color: #888; padding-top: 0.3rem; }
  .msg a { color: #8b7355; }
  .tag { flex: none; font-size: 0.72rem; font-weight: 700; padding: 0.05rem 0.5rem; border-radius: 999px; margin-top: 0.2rem; white-space: nowrap; }
  .tag-add { background: #e6f2e6; color: #2f6b2f; }
  .tag-skip { background: #f8e3e0; color: #9b3b2f; }
  .tag-note { background: #efe9dd; color: #6d5a43; }
  .source { font-size: 0.8em; color: #999; }

  .kaddish-link { text-align: center; margin: 1.2rem 0; }
  .kaddish-link a { font-weight: 700; color: #8b7355; text-decoration: none; }
  .sources { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #e0d8c8; }
  .sources h3 { font-size: 0.95rem; color: #6d5a43; margin-bottom: 0.3rem; }
  .sources p { font-size: 0.85rem; color: #777; }
  .sources a { color: #8b7355; }

  @media (max-width: 520px) {
    .container { padding: 1.25rem 1rem 2.5rem; }
    h1 { font-size: 1.6rem; }
    .prayer { padding: 0.75rem 0.85rem; }
  }
</style>
